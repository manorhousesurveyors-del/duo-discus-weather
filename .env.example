# Optional non-secret settings. Export them explicitly; no dotenv loader is used.
DUO_DATABASE_PATH=var/duo_discus.sqlite3
DUO_HTTP_TIMEOUT_SECONDS=20
DUO_HTTP_MAX_ATTEMPTS=3
DUO_HTTP_WORKERS=3
DUO_HTTP_MIN_INTERVAL_SECONDS=1.2
DUO_OPEN_METEO_CALLS_PER_MINUTE=300
DUO_FORECAST_CACHE_SECONDS=900
DUO_AVIATION_CACHE_SECONDS=60
DUO_METAR_MAX_AGE_MINUTES=90
DUO_MAX_GRID_POINTS=500

# Optional recorded dashboard (labelled, no live radar/aviation).
# DUO_DASHBOARD_SNAPSHOT=var/briefings/forecast-bundle.json

# Notification settings, required only for alerts.py --send.
DUO_ALERT_CHANNELS=email,whatsapp
DUO_EMAIL_TO=manorhousesurveyors@gmail.com
SMTP_USERNAME=manorhousesurveyors@gmail.com
DUO_WHATSAPP_TO=+447976125887
WHATSAPP_PROVIDER=callmebot

# Provision credentials securely in runtime/GitHub secrets. Never commit values.
# GMAIL_APP_PASSWORD=
# CALLMEBOT_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+441234567890
# TWILIO_CONTENT_SID=HX...

# Optional public app address for phone/PDA QR links, including deployment prefix.
# DUO_PUBLIC_BASE_URL=https://weather.example/soaring
# Optional calibrated radar JSON feed; RainViewer alone cannot provide mm/h.
# See docs/map-modes-and-task-sheets.md for the validated grid contract.
# DUO_RADAR_RATE_GRID_URL=https://your-radar-provider.example/uk-rates.json
